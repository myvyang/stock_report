  "company_understanding": {
    "business_engine": {
      "summary": "利润核心是山西潘庄、马必煤层气区块；新疆城燃提供下游网络但毛利较薄，喀什北常规气开始贡献。客户为管道运营商、城燃及工业用户，资源禀赋、低成本开采和管道连接决定盈利。",
      "payers": [
        "管道运营商和城市燃气公司",
        "工业用户",
        "新疆居民、商业及车用气客户"
      ],
      "purchase_reasons": [
        "稳定就近气源",
        "管网连接和调峰能力",
        "城市燃气特许经营与入户服务"
      ],
      "profit_mechanism": "煤层气售价相对稳定、单位成本和折耗决定高毛利；2025年煤层气收入30.5亿元但毛利率降至46.6%，城燃供应毛利率仅9.58%。",
      "asset_and_fund_logic": "成熟区块持续折耗并产生现金，新区块在审批、勘探和建设期先吞噬大量现金；经营周转净额很轻，但油气资产、在建工程和探矿权预付款很重。",
      "evidence_ids": [
        "filing-2025",
        "inquiry-reply-2025"
      ],
      "counterevidence_ids": [
        "inquiry-reply-2025"
      ]
    },

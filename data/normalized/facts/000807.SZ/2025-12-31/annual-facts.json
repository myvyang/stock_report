  "business_overview": {
    "one_sentence": "公司从事铝土矿开采、氧化铝、电解铝、铝加工及铝用炭素生产和销售，2025年主业围绕绿色铝一体化产业链运行。",
    "segments": [
      "氧化铝",
      "电解铝及铝商品",
      "铝合金及铝加工",
      "阳极炭素、石墨化阴极等配套产业",
      "再生铝及固废资源综合利用"
    ],
    "revenue_model": "以铝商品、氧化铝、铝合金及配套材料销售取得收入，盈利受铝价、氧化铝/电力等成本和产销量影响。",
    "business_notes": [
      "年报披露形成氧化铝140万吨、电解铝308万吨、阳极炭素80万吨、石墨化阴极2万吨、绿色铝合金161万吨产业规模。",
      "报告期铝商品销量、销价同比上升带动经营现金流增加。"
    ]
  },

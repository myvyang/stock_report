  "business_overview": {
    "one_sentence": "海信家电主要从事暖通空调、冰箱、冷柜、洗衣机、厨房电器、汽车空调压缩机和汽车综合热管理系统的研发、制造、营销和服务。",
    "segments": [
      "暖通空调",
      "冰箱/冷柜/洗衣机/厨电",
      "汽车空调压缩机及综合热管理系统"
    ],
    "revenue_model": "制造产品销售、渠道销售和相关服务收入，主要依赖家电及热管理产品规模化制造与销售。",
    "business_notes": [
      "公司属于家用制冷电器具制造行业。",
      "合并范围包含海信日立、三电株式会社等业务，存在少数股东权益和联营企业收益。"
    ]
  },

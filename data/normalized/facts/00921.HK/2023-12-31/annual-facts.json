  "business_overview": {
    "one_sentence": "海信家电经营暖通空调、冰洗厨电等家庭及商用电器，并包含三电汽车热管理业务。",
    "segments": [
      "暖通空调",
      "冰洗厨电",
      "其他（含三电汽车热管理等）"
    ],
    "revenue_model": "通过家用/商用空调、冰箱、洗衣机、厨电及汽车热管理产品的研发、制造和销售取得收入，国内与海外多品牌、多渠道销售。",
    "business_notes": [
      "2023 年海外业务收入约 RMB279.2 亿元，同比增 12.3%。",
      "2023 年员工 56,240 人，制造和销售人员占比较高。"
    ]
  },

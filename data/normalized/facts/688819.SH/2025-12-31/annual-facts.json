  "business_overview": {
    "one_sentence": "公司以铅蓄电池为基本盘，拓展锂电、固态/钠离子/氢燃料等新能源电池产品，面向电动轻型车、储能、工业备用电源等场景。",
    "segments": [
      "铅蓄电池",
      "锂电池及储能/轻型动力",
      "混合固液与固态电池研发",
      "钠离子电池",
      "氢燃料电池"
    ],
    "revenue_model": "制造并销售各类动力、储能和工业电池产品，经营需要较大原材料、自制半成品、库存商品、票据结算和保证金支持。",
    "business_notes": [
      "年报第三节披露铅蓄电池行业龙头地位、锂电业务规模化生产、钠电已实现销售、氢燃料电池小批量交付。",
      "前五名供应商及客户因商业秘密豁免披露。"
    ]
  },

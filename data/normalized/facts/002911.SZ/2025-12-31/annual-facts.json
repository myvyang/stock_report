  "business_overview": {
    "one_sentence": "公司以城市燃气为基础，经营天然气销售与输配、能源化工服务、冷热能/光伏/储能等综合能源和工程服务。",
    "segments": [
      "城市燃气及天然气供应",
      "能源化工服务和石化仓储/码头协同",
      "冷热能、光伏、储能等新能源服务",
      "工程服务和科技研发装备"
    ],
    "revenue_model": "向工商业、居民、电厂等客户销售天然气，并围绕成品油、燃料油、甲醇、生物柴油、沥青等能源化工品提供采购、仓储、物流和销售服务；部分收益来自 LNG 长期合约及套期。",
    "business_notes": [
      "2025年营业收入335.95亿元，能源化工服务及其他业务收入203.90亿元；总天然气供应量47.56亿方。",
      "公司拥有佛山及若干外地管道燃气特许经营权，管网、储配站和能源化工仓储码头是经营必需资产。"
    ]
  },

  "business_overview": {
    "one_sentence": "上汽集团以整车、零部件、物流、汽车金融和相关投资平台为核心，2025年整车销售450.7万辆，自主品牌、新能源和海外业务是主要经营抓手。",
    "segments": [
      "整车制造与销售",
      "汽车零部件",
      "汽车物流",
      "汽车金融及财务公司",
      "产业投资及股权投资"
    ],
    "revenue_model": "主要通过销售整车、零部件、材料和配件取得收入，并通过汽车金融、财务公司、物流和投资收益贡献利润。",
    "business_notes": [
      "2025年整车销售450.7万辆，同比增长12.3%；自主品牌销量292.8万辆，占比约65%。",
      "合并范围包含上海汽车集团财务有限责任公司、上汽通用汽车金融、上海东正汽车金融及保险主体，资金资产和经营现金流受到金融业务显著影响。"
    ]
  },

  "business_overview": {
    "one_sentence": "集团通过中国内地营运学校和学校举办者提供民办高等教育服务，收入主要来自学费和住宿费，并通过结构性合约享有相关经济利益。",
    "segments": [
      {
        "segment": "PRC Operation Schools and School Sponsors",
        "revenue": 2599427000,
        "assets": 10768860000,
        "currency": "CNY",
        "source": "2024/2025 annual report p.70, revenue and assets involved in structured contracts"
      }
    ],
    "revenue_model": "学生在学年开始前预付学费和住宿费，集团按课程相关期间确认收入；未提供服务部分列为合同负债，学生对未提供服务部分有退款权。",
    "business_notes": [
      "中国高等教育属于外商投资负面清单“受限制”类别，集团通过结构性合约控制相关教育服务附属公司。",
      "2025 年资本开支主要用于贵州学校申本升级、其他学校楼宇设施建设、土地购置和家具设备。"
    ]
  },

  "business_overview": {
    "one_sentence": "公司以膜材料、膜组件、膜设备和膜应用为核心，经营膜技术应用业务和市政污水处理等水务投资运营业务。",
    "segments": [
      {
        "name": "膜技术应用",
        "description": "工业料液分离、膜法水处理、环境工程、膜备件及民用净水机等产品和服务。"
      },
      {
        "name": "水务投资运营",
        "description": "通过EPC、BOT、BT、TOT等方式提供市政污水处理设施投资运营与管理服务，按处理水量和水价收费。"
      }
    ],
    "revenue_model": "膜技术应用通过整体解决方案、设备、膜材料和后续备件/服务取得收入；水务投资运营按污水处理量和水价取得服务费。",
    "business_notes": [
      "客户包括制造业、市政管理部门和终端净水用户；项目制和水务特许经营导致应收账款、存货、合同负债和无形资产占用较大。"
    ]
  },
